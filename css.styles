body {
font-family: Arial, sans-serif;
margin: 0px;
padding: 20px;

}

h1, h2, h3 {
color: black;
}

a {
color: blue;
font-weight: bold;    
}

table {
width: 100%;
border-collapse: collapse;
margin-top: 15px;
}

img {
display: block;
margin-left: auto;
margin-right: auto;
border-radius: 10px;
}

.center {
display: block;
margin-left: auto;
margin-right: auto;
}


nav {
background-color: #C5C6C7;
padding: 10px;
display: flex;
justify-content: center;
gap: 10px;
}

nav a {
color: white;
padding: 10px 15px;
background-color: black;
border-radius: 4px;
}


.container {
width: 80%;
margin: auto;       
background: white;
padding: 20px;
margin-top: 20px;
box-shadow: 0px 0px 10px #ccc;
}


footer {
background-color: #333;
color: white;
text-align: center;
padding: 15px;
margin-top: 30px;
}

