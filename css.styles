body {
font-family: Arial, sans-serif;
margin: 0px;
padding: 20px;

}

h1, h2, h3 {
color: black;
}

a {
color: blue;
font-weight: bold;    
}

table {
width: 100px;   
}

img {
width: 30%;
margin: 1%;
border: 2px solid black;
}


nav {
background-color: #333;
padding: 10px;
display: flex;
justify-content: center;
gap: 10px;
}

nav a {
color: white;
padding: 10px 15px;
background-color: #555;
border-radius: 4px;
}


container {
width: 80%;
margin: auto;       
background: white;
padding: 20px;
margin-top: 20px;
box-shadow: 0px 0px 10px #ccc;
}