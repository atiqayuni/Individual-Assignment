body {
font-family: Times New Roman;
background-color: #E8E9EB;
margin: 0px;
padding: 20px;

}

h1, h2, h3 {
color: black;
}

a {
color: blue;
font-weight: bold;    
}

table {
width: 100px;   
}

img {
width: 30%;
margin: 1%;
border: 2px solid black;
}

ul {
list-style-type: none;
margin: 0;
padding: 0;
display: flex;
border: 1px solid #e7e7e7;
background-color: #f3f3f3;
}
