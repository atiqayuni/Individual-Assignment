body {
font-family: Arial, sans-serif;
margin: 0px;
padding: 20px;
background-color: #C1B6A4

}

h1, h2, h3 {
color: black;
}

a {
color: blue;
font-weight: bold;    
}

table {
border-collapse: collapse;
width: 100%;
margin-top: 20px;
margin-bottom: 20px;
}

th, td {
padding: 8px;
text-align: left;
}

.center {
display: block;
margin-left: auto;
margin-right: auto;
}

nav {
background-color: #B29079;
padding: 10px;
display: flex;
justify-content: center;
gap: 10px;
}

nav a {
color: white;
padding: 10px 15px;
background-color: #F6F5EC;
border-radius: 4px;
}

.container {
width: 80%;
margin: auto;       
background: #0F1A2B;
padding: 20px;
margin-top: 20px;
box-shadow: 0px 0px 10px #ccc;
}

footer {
background-color: #D1CFC9;
color: white;
text-align: center;
padding: 15px;
margin-top: 30px;
}

